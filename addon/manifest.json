{
  "manifest_version": 3,
  "name": "EfMailAgent",
  "description": "Az előrendelési és egyéb e-maileket a helyi EfMailAgent szolgáltatásnak küldi AI-alapú feldolgozásra, és címkével jelzi az eredményt.",
  "version": "1.1.0",
  "author": "Energofish",
  "browser_specific_settings": {
    "gecko": {
      "id": "efmailagent@energofish.hu",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "32": "icons/efmailagent.svg",
    "64": "icons/efmailagent.svg"
  },
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "menus",
    "storage",
    "alarms"
  ],
  "host_permissions": ["http://127.0.0.1/*"]
}
